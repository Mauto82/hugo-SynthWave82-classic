{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{- $defaultLang := hugo.Sites.Default.Language.Lang -}}
{{- range .Site.Pages.ByPublishDate.Reverse -}}
{{- if eq .Section "tags" }}{{ continue }}{{ end -}}
{{- if or (eq .Layout "search") (in .RelPermalink "/search/") }}{{ continue }}{{ end -}}
{{- if and (eq .Kind "term") (lt (len .Pages) 3) }}{{ continue }}{{ end -}}
{{- if .Params.noindex }}{{ continue }}{{ end -}}
<url>
    <loc>{{- .Permalink -}}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{- .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML -}}</lastmod>
    {{- end }}
    {{- if .IsTranslated }}
    {{- range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ .Permalink }}" />
    {{- end }}
    {{- range first 1 (where .AllTranslations "Language.Lang" $defaultLang) }}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ .Permalink }}" />
    {{- end }}
    {{- end }}
    <changefreq>{{ .Sitemap.ChangeFreq }}</changefreq><priority>{{ .Sitemap.Priority }}</priority>
</url>
{{- end }}
</urlset>
